<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileApp.Screens.CharactersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Characters">

    <Grid>
        <CollectionView
            x:Name="CharactersCollection"
            Margin="16"
            SelectionMode="Single"
            SelectionChanged="OnCharacterSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" Padding="16" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding Name}" />
                            <Label
                                FontSize="14"
                                Text="{Binding Description}"
                                TextColor="{AppThemeBinding Dark=LightGray, Light=Gray}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            x:Name="LoadingIndicator"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="False"
            IsRunning="False" />

        <Button
            Text="+"
            FontSize="32"
            WidthRequest="64"
            HeightRequest="64"
            CornerRadius="32"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,32"
            Clicked="OnAddCharacterClicked" />
    </Grid>

</ContentPage>

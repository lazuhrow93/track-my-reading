<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileApp.Screens.CharacterProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Margin="16" Spacing="24">

            <!-- Name + edit -->
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label
                    x:Name="NameLabel"
                    FontAttributes="Bold"
                    FontSize="26"
                    VerticalOptions="Center" />
                <Label
                    Text="✏"
                    FontSize="14"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Dark=LightGray, Light=Gray}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- About -->
            <VerticalStackLayout Spacing="8">
                <Label Text="About" FontAttributes="Bold" FontSize="18" />
                <Label
                    x:Name="DescriptionLabel"
                    FontSize="15"
                    TextColor="{AppThemeBinding Dark=LightGray, Light=Gray}" />
            </VerticalStackLayout>

            <!-- Traits -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Traits" FontAttributes="Bold" FontSize="18" />
                <FlexLayout
                    x:Name="TraitsLayout"
                    Wrap="Wrap"
                    Direction="Row"
                    JustifyContent="Start" />
            </VerticalStackLayout>

            <!-- Notes -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Notes" FontAttributes="Bold" FontSize="18" />
                <VerticalStackLayout x:Name="NotesLayout" Spacing="8" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
